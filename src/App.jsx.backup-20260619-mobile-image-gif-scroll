      .map((topping) => topping.name);

  const getVisibleToppingOptions = (drinkName) =>
    toppingOptions
      .filter((topping) => {
        if (drinkName === 'RAPIDÍN' && topping.name === 'Perlas Explosivas') return false;
        return !topping.onlyFor || topping.onlyFor.includes(drinkName);
